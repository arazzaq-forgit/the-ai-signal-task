# Copy this file to .env (or just set these as real environment variables
# in your shell) and fill in real values. NEVER commit a file with real
# credentials in it — .env is already excluded via .gitignore.
#
# Every pipeline works with a subset of these configured — see README.md
# for which command needs which key, and where to get each one for free.

# --- GitHub (papers pipeline: fetching live star counts) ---
GITHUB_TOKEN=

# --- Product Hunt (products pipeline) ---
PRODUCTHUNT_TOKEN=

# --- LLM extraction chain (extract-news) — configure at least one ---
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Google Sheets export ---
# Path to your downloaded service account JSON file, e.g.:
# GOOGLE_SHEETS_CREDS=C:\Users\you\Downloads\my-project-creds.json
GOOGLE_SHEETS_CREDS=
